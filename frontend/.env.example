# ControlPlane.ai — Frontend environment variables
#
# In development, the Vite dev server proxies /api/* -> http://localhost:8000
# automatically, so you do NOT need to set VITE_API_URL locally.
#
# Set this variable in production to point to your deployed FastAPI instance.
# VITE_API_URL=https://api.your-controlplane-domain.com
VITE_API_URL=
