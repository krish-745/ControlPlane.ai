# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# ── LLM Backend ──────────────────────────────────────────────────────────────
# --- LLM Backend Configuration ---
# "mock" uses predefined fixtures from mocks/scenarios.json (safest for reliable demos)
# "live" calls real models via LiteLLM
LLM_BACKEND=mock

# The default model to route to in "live" mode
# Examples: 
#   OpenAI: "gpt-4o-mini"
#   Anthropic: "claude-3-5-sonnet-20240620"
#   Groq: "groq/llama3-8b-8192"
#   Gemini: "gemini/gemini-1.5-flash"
LLM_MODEL=gpt-4o-mini

# Required if LLM_BACKEND=live
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# ── Postgres ─────────────────────────────────────────────────────────────────
# For local databases, you can set the individual components:
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=controlplane
POSTGRES_PASSWORD=controlplane
POSTGRES_DB=controlplane

# OR use a direct connection string for Supabase or other hosted databases
# Supabase Transaction Pooler example (Port 6543):
# DATABASE_URL="postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"

# ── Redis ─────────────────────────────────────────────────────────────────────
# For local redis:
REDIS_HOST=localhost
REDIS_PORT=6379

# OR use a direct connection string for Upstash or other hosted Redis
# REDIS_URL_OVERRIDE="rediss://default:[password]@[upstash-url]"

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Policy Defaults ───────────────────────────────────────────────────────────
DEFAULT_GROUNDING_SIMILARITY_MIN=0.75
DEFAULT_LOOP_COUNT_MAX=3
