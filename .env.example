# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# ── LLM Backend ──────────────────────────────────────────────────────────────
# Set to "mock" to use hand-crafted fixtures (pitch demo mode)
# Set to "live" to route through LiteLLM to real providers
LLM_BACKEND=mock

# Required only when LLM_BACKEND=live
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=controlplane
POSTGRES_PASSWORD=controlplane
POSTGRES_DB=controlplane

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Policy Defaults ───────────────────────────────────────────────────────────
DEFAULT_GROUNDING_SIMILARITY_MIN=0.75
DEFAULT_LOOP_COUNT_MAX=3
