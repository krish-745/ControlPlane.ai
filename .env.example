# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# ── LLM Backend ──────────────────────────────────────────────────────────────
# Set to "mock" to use hand-crafted fixtures (pitch demo mode)
# Set to "live" to route through LiteLLM to real providers
LLM_BACKEND=mock

# Required only when LLM_BACKEND=live
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ── Postgres ─────────────────────────────────────────────────────────────────
# For local databases, you can set the individual components:
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=controlplane
POSTGRES_PASSWORD=controlplane
POSTGRES_DB=controlplane

# OR use a direct connection string for Supabase or other hosted databases
# Supabase Transaction Pooler example (Port 6543):
# DATABASE_URL="postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"

# ── Redis ─────────────────────────────────────────────────────────────────────
# For local redis:
REDIS_HOST=localhost
REDIS_PORT=6379

# OR use a direct connection string for Upstash or other hosted Redis
# REDIS_URL_OVERRIDE="rediss://default:[password]@[upstash-url]"

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Policy Defaults ───────────────────────────────────────────────────────────
DEFAULT_GROUNDING_SIMILARITY_MIN=0.75
DEFAULT_LOOP_COUNT_MAX=3
